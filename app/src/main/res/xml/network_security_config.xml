<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS فقط، مع شهادة النظام. لا تساهل بشهادات مستخدم على نطاق الإنتاج. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
